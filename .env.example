# Copy this file to .env.local and fill in real values there.
# .env.local is git-ignored - never commit real keys or URLs into this file.

# Server-only. Never expose this to the browser - every file that reads it
# lives under app/api/**/route.ts (Route Handlers run only on the server).
GEMINI_API_KEY=

# Supabase project settings -> API. The URL and the publishable/anon key
# are BOTH meant to be exposed to the browser (that's what NEXT_PUBLIC_
# means, and why the key is literally called "publishable"). Never put
# the service_role key here or anywhere client-reachable - it bypasses
# Row Level Security entirely.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
